<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Merged with the keys Xcode generates from INFOPLIST_KEY_* (project.yml). -->
	<!-- TLS (Network.framework QUIC) and CryptoKit for pairing and authentication only: exempt encryption. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
	<!-- Pairing links (DESIGN §3.1 pairing): the QR code the host's "Pair a Device…" window shows; Camera's "Open in Mirage". -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>com.paulherz.mirage.pair</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>miragerd</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>Mirage uses the camera to scan the pairing code your Mac shows.</string>
</dict>
</plist>
